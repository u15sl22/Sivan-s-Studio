SIVAN_PORT=8766
SIVAN_TOKEN_SECRET=replace-with-a-long-random-secret
SIVAN_TEACHER_USERNAME=sivan.teacher
SIVAN_TEACHER_PASSWORD=replace-with-a-strong-teacher-password
# Maximum background processing time for one PDF. Complete manifests are still recovered after an abnormal Python exit.
SIVAN_PDF_TIMEOUT_SECONDS=900
# Optional absolute Python path. Leave unset when python is available on PATH.
# SIVAN_PYTHON=/usr/bin/python3
